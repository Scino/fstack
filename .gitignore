# ==========================================
# fstack Git Ignore
# ==========================================

# Reference & upstream vendor repositories
/inspiration/
inspiration/

# Node.js dependencies & builds
node_modules/
dist/
build/
coverage/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# fstack runtime data & caches
.fstack/
.cache/

# Local installation duplicates (skills/ is the source of truth)
.cursor/
.agents/

# Environment files & secrets
.env
.env.local
.env.*.local
!.env.example

# OS system files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Editor directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json